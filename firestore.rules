rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /submissions/{document} {
      // Allow anonymous creation of suggestions with strict schema validation
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.neighborhood is string
                    && request.resource.data.whyRecommend is string
                    && request.resource.data.whyRecommend.size() > 0
                    && request.resource.data.whyRecommend.size() <= 2000
                    && request.resource.data.status == 'pending';
      
      // Only authenticated admin can read, review, or delete submissions
      allow read, update, delete: if request.auth != null 
                                  && (request.auth.token.email == 'mohitgarg.ai@gmail.com' 
                                      || request.auth.token.email == 'admin@getoden.com');
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
