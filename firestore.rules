rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /submissions/{document} {
      allow read: if true;
      allow create: if request.resource.data.name != null;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
